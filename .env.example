# Copy to frontend/.env.local and backend/.env respectively.
# Never commit real keys.

# Frontend (frontend/.env.local)
VITE_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173

# Backend (backend/.env) - loaded by your process manager, NOT by Vite
# AI service credentials (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
SUPABASE_URL=
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
# GFPGAN_WEIGHTS=/absolute/path/to/GFPGANv1.3.pth
GFPGAN_WEIGHT=0.55
# auto | cpu | cuda
GFPGAN_DEVICE=auto

# YOLO11n acne detection. No checkpoint is bundled; train with
# backend/train_yolo11n_colab.ipynb and copy best.pt into backend/models/.
# YOLO_WEIGHTS=/absolute/path/to/best.pt
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45
YOLO_MAX_DIMENSION=1100
# auto | cpu | cuda
YOLO_DEVICE=auto

# Skin-condition classifier. No checkpoint or label map is bundled.
# CATALOG_DATA_DIR=/absolute/path/to/backend/data
